{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"]
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git"]
    },
    "remote-docs": {
      "type": "http",
      "url": "https://mcp.example.test/mcp?session=not-recorded",
      "headers": {"Authorization": "Bearer ${DOCS_TOKEN}"}
    },
    "inline-key": {
      "command": "node",
      "args": ["./tools/server.js"],
      "env": {"SERVICE_KEY": "literal-value-written-here", "LOG_LEVEL_REF": "${LOG_LEVEL}"}
    }
  }
}
