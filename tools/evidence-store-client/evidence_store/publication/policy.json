{
  "schema": "evidence-store.publication-policy/v1",
  "note": "The publication gate for the six Tines-readable result containers (PROTOCOL.md 4.2). Reviewed with the client; shipped inside the vendored package, so a change is a re-pin. USR, ADR and LZ types are PROPOSED v1 envelopes (their builders emit them); kit types are the kit's own in-document ids, and the kit files with no id are DECLARED BY NAME here (v0: type-level validation). MRN_LABELLED is a placeholder for the employer's MRN format: extend it with EVIDENCE_PUBLICATION_DENYLIST. ciso-harness-verdicts (owner approval 2026-11-24) carries the harness RUN_VERIFICATION summary: harness-run-verification.v1 is the harness schema copied verbatim from harness lane/run-verification-2026-11-24 c16469a reference_data/run_verification.schema.json; its .txt companion is declared text.",
  "containers": [
    "usr-reviews",
    "adr",
    "lz-vending",
    "cicd-kit-gates",
    "seal",
    "index",
    "ciso-harness-verdicts"
  ],
  "schema_keys": [
    "schema"
  ],
  "kind_version_keys": [
    "kind",
    "schema_version"
  ],
  "json_content_types": [
    "application/json"
  ],
  "allowed_content_types": [
