  "secret_patterns": [
    [
      "JWT",
      "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}"
    ],
    [
      "AWS_ACCESS_KEY_ID",
      "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    ],
    [
      "AWS_SECRET",
      "(?i)aws_secret_access_key\\s*[=:]\\s*\\S{20,}"
    ],
    [
      "GITHUB_TOKEN",
      "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}"
    ],
    [
      "SLACK_TOKEN",
      "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
    ],
    [
      "ENTRA_CLIENT_SECRET",
      "(?<![A-Za-z0-9_~.-])[A-Za-z0-9_~.-]{3}8Q~[A-Za-z0-9_~.-]{31,34}(?![A-Za-z0-9_~.-])"
    ],
    [
      "PRIVATE_KEY",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    ],
    [
      "BEARER_TOKEN",
      "(?i)\\bBearer\\s+[A-Za-z0-9._~+/-]{20,}"
    ],
    [
      "JSON_SECRET_VALUE",
      "(?i)\"(?:access_?token|refresh_?token|id_?token|client_?secret|password|primaryKey|secondaryKey)\"\\s*:\\s*\"[^\"]{8,}\""
    ],
    [
      "ACCOUNT_KEY",
      "(?i)\\bAccountKey\\s*=\\s*[A-Za-z0-9+/=]{20,}"
    ],
    [
      "SHARED_ACCESS_KEY",
      "(?i)\\bSharedAccessKey\\s*=\\s*[A-Za-z0-9+/=]{20,}"
    ],
    [
      "STORAGE_CONNECTION_STRING",
      "(?i)\\bDefaultEndpointsProtocol\\s*=\\s*https?\\s*;"
    ],
    [
      "PASSWORD_IN_CONNECTION_STRING",
      "(?i)(?:^|[;\"\\s])(?:Password|Pwd)\\s*=\\s*[^;\\s\"]{4,}\\s*;"
    ],
    [
      "INSTRUMENTATION_KEY",
      "(?i)\\bInstrumentationKey\\s*=\\s*[0-9a-f-]{36}"
    ],
    [
      "SAS_SIGNATURE",
      "(?i)[?&;]sig=[A-Za-z0-9%+/=]{10,}"
    ],
    [
      "SAS_QUERY",
      "(?i)\\bsv=[0-9]{4}-[0-9]{2}-[0-9]{2}&.*\\bsig="
    ]
  ],
  "phi_cui_patterns": [
    [
      "SSN_LIKE",
      "(?<![0-9A-Za-z-])(?!000|666|9[0-9]{2})[0-9]{3}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}(?![0-9A-Za-z-])"
    ],
    [
      "MRN_LABELLED",
      "(?i)\\b(?:MRN|medical[ _-]?record[ _-]?(?:number|no\\.?|num|#))\\b\"?\\s*[:#=]?\\s*\"?[A-Za-z]{0,3}[0-9][0-9-]{4,}"
    ],
    [
      "CUI_BANNER_LINE",
      "(?m)^[ \\t]*(?:CUI|CONTROLLED)(?://[A-Z0-9][A-Z0-9 ,/-]*)?[ \\t]*$"
    ],
    [
      "CUI_CATEGORY_MARKING",
      "\\bCUI//(?:SP-)?[A-Z]{2,}"
    ],
    [
      "CUI_MARKING_FIELD",
      "(?i)\"(?:banner|marking|markings|classification|dissemination|cui_marking)\"\\s*:\\s*\"(?:CUI|CONTROLLED)\\b"
    ]
  ]
}
