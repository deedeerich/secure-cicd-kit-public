{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr.controls-baseline/v1",
  "title": "ADR controls-baseline release (envelope)",
  "type": "object",
  "required": [
    "schema",
    "release",
    "released_at_utc",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "adr.controls-baseline/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "released_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "array"
    }
  }
}
