{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr.snapshot/v1",
  "title": "ADR builder snapshot (envelope)",
  "type": "object",
  "required": [
    "schema",
    "snapshot_id",
    "created_at_utc",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "adr.snapshot/v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array"
    }
  }
}
