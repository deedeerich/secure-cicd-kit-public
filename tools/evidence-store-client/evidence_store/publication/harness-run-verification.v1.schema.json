{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:run-verification:v1",
  "title": "RUN_VERIFICATION.json -- the safe summary of one harness run (src/verify_run.py, HDEC-022 disclosure)",
  "description": "Four independent facts about one harness run -- execution, integrity, coverage, assessment -- and one verdict. VERDICT RULE: the verdict is derived from execution, integrity and coverage ONLY: FAIL when execution is FAIL, integrity is FAILED or coverage is CONFLICT; else PASS_WITH_GAPS when execution is NOT_ESTABLISHED or coverage is GAPS or NOT_ESTABLISHED; else PASS. Assessment is always NOT_ASSESSED_BY_HARNESS and never enters the verdict: a run over an insecure environment can PASS, and a run whose evidence is intact can be PASS_WITH_GAPS. Integers as strings (a count, <t, or SUPPRESSED), the harness vocabulary, ENV-n labels and sha256 hashes only. Never a file name from the corpus, an asset name, an identifier or a value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "harness_commit",
    "build_day",
    "verdict",
    "verdict_reasons",
    "meaning",
    "verdict_rule",
    "execution",
    "assessment",
    "integrity",
    "coverage",
    "disclosure",
    "anchors",
    "never_contains"
  ],
  "$defs": {
    "count": {
      "type": "string",
      "pattern": "^([0-9]{1,9}|<[0-9]{1,3}|SUPPRESSED)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_or_absent": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|NOT_PRESENT)$"
    },
    "check": {
      "type": "string",
      "enum": [
        "OK",
        "FAIL",
        "NOT_PRESENT",
        "GAPS",
        "NOT_ESTABLISHED"
      ]
    },
    "word": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,.;:()<>'_-]{0,400}$"
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "collector_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pull_[a-z0-9_]{1,60}$"
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "const": "harness-run-verification.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "harness_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|NOT_RECORDED|OTHER)$"
    },
    "build_day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_GAPS",
        "FAIL"
      ]
    },
    "verdict_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "dimension",
          "meaning"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTEGRITY_MANIFEST_FAILED",
              "INTEGRITY_DERIVATION_FAILED",
              "INTEGRITY_RUN_RECEIPT_FAILED",
              "REQUIRED_CONFLICT",
              "REQUIRED_EVIDENCE_MISSING",
              "REQUIRED_EVIDENCE_PARTIAL",
              "PLAN_REQUIRED_NOT_COLLECTED",
              "MISPLACED_HISTORY",
              "REQUIRED_EVIDENCE_NOT_VERIFIED",
              "RUN_RECEIPT_NOT_PRESENT",
              "RUN_RECEIPT_IDENTITY_DIFFERS",
              "COVERAGE_NOT_ESTABLISHED",
              "EXECUTION_COLLECTOR_EXIT_NONZERO",
              "EXECUTION_TOOL_ERROR",
              "EXECUTION_EXIT_CODES_NOT_RECORDED"
            ]
          },
          "meaning": {
            "$ref": "#/$defs/word"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "execution",
              "integrity",
              "coverage"
            ]
          }
        }
      }
    },
    "meaning": {
      "$ref": "#/$defs/word"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "meaning",
        "checks"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "HOLDS",
            "FAILED"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/word"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_manifests",
            "derivations",
            "run_receipts"
          ],
          "properties": {
            "evidence_manifests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "folders",
                "entries_by_state",
                "entries_total"
              ],
              "properties": {
                "verdict": {
                  "$ref": "#/$defs/check"
                },
                "folders": {
                  "$ref": "#/$defs/count"
                },
                "entries_by_state": {
                  "$ref": "#/$defs/states"
                },
                "entries_total": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "derivations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "outputs_by_state",
                "outputs_total"
              ],
              "properties": {
                "verdict": {
                  "$ref": "#/$defs/check"
                },
                "outputs_by_state": {
                  "$ref": "#/$defs/states"
                },
                "outputs_total": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "run_receipts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "receipts",
                "files_changed_or_vanished",
                "receipts_unreadable",
                "identity_differs"
              ],
              "properties": {
                "verdict": {
                  "$ref": "#/$defs/check"
                },
                "receipts": {
                  "$ref": "#/$defs/count"
                },
                "files_changed_or_vanished": {
                  "$ref": "#/$defs/count"
                },
                "receipts_unreadable": {
                  "$ref": "#/$defs/count"
                },
                "identity_differs": {
                  "$ref": "#/$defs/count"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "meaning",
        "basis",
        "environments",
        "checklists_in_scope",
        "checks",
        "required_by_state",
        "required_by_checklist",
        "optional_by_state",
        "plan_required_not_collected",
        "misplaced_history_folders",
        "present_not_verified_blocks_pass"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "COMPLETE_AGAINST_MAP",
            "GAPS",
            "CONFLICT",
            "NOT_ESTABLISHED"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/word"
        },
        "basis": {
          "type": "string",
          "enum": [
            "CHECKLIST_EVIDENCE_MAP",
            "NOT_ESTABLISHED"
          ]
        },
        "environments": {
          "$ref": "#/$defs/count"
        },
        "checklists_in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ai-governance",
              "data-edocuments",
              "identity-access",
              "logging-ir-resilience",
              "network-hybrid",
              "platform-cloud-onprem",
              "sdlc-appsec",
              "governance-risk",
              "privacy",
              "vendor-third-party-risk",
              "healthcare-hipaa-overlay",
              "networked-medical-devices-overlay",
              "aviation-overlay"
            ]
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_conflict",
            "required_collected",
            "plan_required_collected",
            "history_layout"
          ],
          "properties": {
            "required_conflict": {
              "$ref": "#/$defs/check"
            },
            "required_collected": {
              "$ref": "#/$defs/check"
            },
            "plan_required_collected": {
              "$ref": "#/$defs/check"
            },
            "history_layout": {
              "type": "string",
              "enum": [
                "OK",
                "MISPLACED_HISTORY"
              ]
            }
          }
        },
        "required_by_state": {
          "$ref": "#/$defs/states"
        },
        "required_by_checklist": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/states"
          }
        },
        "optional_by_state": {
          "$ref": "#/$defs/states"
        },
        "plan_required_not_collected": {
          "$ref": "#/$defs/count"
        },
        "misplaced_history_folders": {
          "$ref": "#/$defs/count"
        },
        "present_not_verified_blocks_pass": {
          "type": "boolean"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "rule"
      ],
      "properties": {
        "threshold": {
          "type": "integer"
        },
        "rule": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifests",
        "case_manifest_root_sha256",
        "derivation_index_sha256",
        "summary_sha256",
        "summary_sha256_rule"
      ],
      "properties": {
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "folder",
              "sha256"
            ],
            "properties": {
              "folder": {
                "type": "string",
                "pattern": "^(CASE|ENV-[0-9]{1,4}|OTHER)$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "case_manifest_root_sha256": {
          "$ref": "#/$defs/sha256_or_absent"
        },
        "derivation_index_sha256": {
          "$ref": "#/$defs/sha256_or_absent"
        },
        "summary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary_sha256_rule": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "never_contains": {
      "$ref": "#/$defs/word"
    },
    "verdict_rule": {
      "$ref": "#/$defs/word"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "meaning",
        "checks",
        "collectors"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "OK",
            "NOT_ESTABLISHED",
            "FAIL"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/word"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collector_exits",
            "tool_runs",
            "session"
          ],
          "properties": {
            "collector_exits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "collectors_with_a_code",
                "non_zero",
                "ran_without_a_code"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "OK",
                    "FAIL",
                    "NOT_RECORDED"
                  ]
                },
                "collectors_with_a_code": {
                  "$ref": "#/$defs/count"
                },
                "non_zero": {
                  "$ref": "#/$defs/count"
                },
                "ran_without_a_code": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "tool_runs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "tools",
                "errors"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "OK",
                    "FAIL"
                  ]
                },
                "tools": {
                  "$ref": "#/$defs/count"
                },
                "errors": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "OK",
                    "NOT_PRESENT",
                    "IDENTITY_DIFFERS"
                  ]
                }
              }
            }
          }
        },
        "collectors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run",
            "partly_run",
            "not_run",
            "names_not_in_vocabulary"
          ],
          "properties": {
            "run": {
              "$ref": "#/$defs/collector_list"
            },
            "partly_run": {
              "$ref": "#/$defs/collector_list"
            },
            "not_run": {
              "$ref": "#/$defs/collector_list"
            },
            "names_not_in_vocabulary": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "meaning",
        "derived_findings",
        "enters_the_verdict"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "const": "NOT_ASSESSED_BY_HARNESS"
        },
        "meaning": {
          "$ref": "#/$defs/word"
        },
        "derived_findings": {
          "type": "string",
          "pattern": "^(NOT_COUNTED|[0-9]{1,9}|<[0-9]{1,3}|SUPPRESSED)$"
        },
        "enters_the_verdict": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
