# Baseline .gitignore — employer-neutral developer safety rails.
# Extend locally; do not remove entries. Templates stay trackable via negations.

# ---- Secrets and local environment ------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
credentials
credentials.json
service-account*.json
*_rsa
*.ovpn
secrets.*
!secrets.example.*
recovery-codes*
recovery_codes*
*token*.txt
*.token

# ---- Cloud / auth caches -----------------------------------------------------
.azure/
.aws/
.kube/config
.gcloud/
azureProfile.json
accessTokens.json
.msal_cache*
*.publishsettings

# ---- Terraform ---------------------------------------------------------------
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
.terraformrc
terraform.rc
tfplan
*.tfplan

# ---- Build artifacts ---------------------------------------------------------
dist/
build/
out/
target/
*.egg-info/
__pycache__/
*.py[cod]
node_modules/
.next/
.nuxt/
*.war
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ---- Test / tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
.nyc_output/
.cache/
.gradle/

# ---- Scan output (should not be committed; publish as artifacts) -------------
*.sarif
sbom.json
sbom.spdx.json
sbom.cyclonedx.json
dependency-check-report.*
trivy-*.json
trivy-*.txt
semgrep-*.json
bandit-*.json
gitleaks-report.json
scan-results/
nvd-scan-results/
.dependency-check-data/

# ---- Local databases / dumps -------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.mdb
*.bak
*.dump
*.sql.gz

# ---- IDE / editor ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*.sublime-*
.history/

# ---- OS ----------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
__MACOSX/

# ---- Archives that usually shouldn't be tracked ------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
!docs/**/*.zip
