{
  "name": "kit-block-secret-files",
  "target": "push",
  "enforcement": "active",
  "bypass_actors": [],
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          ".env",
          "**/.env",
          "**/.*/**/.env",
          ".env.[a-df-zA-Z0-9._-]*",
          "**/.env.[a-df-zA-Z0-9._-]*",
          "**/.*/**/.env.[a-df-zA-Z0-9._-]*",
          ".env.e",
          "**/.env.e",
          "**/.*/**/.env.e",
          ".env.e[a-wy-zA-Z0-9._-]*",
          "**/.env.e[a-wy-zA-Z0-9._-]*",
          "**/.*/**/.env.e[a-wy-zA-Z0-9._-]*",
          ".env.ex",
          "**/.env.ex",
          "**/.*/**/.env.ex",
          ".env.ex[b-zA-Z0-9._-]*",
          "**/.env.ex[b-zA-Z0-9._-]*",
          "**/.*/**/.env.ex[b-zA-Z0-9._-]*",
          ".env.exa",
          "**/.env.exa",
          "**/.*/**/.env.exa",
          ".env.exa[a-ln-zA-Z0-9._-]*",
          "**/.env.exa[a-ln-zA-Z0-9._-]*",
          "**/.*/**/.env.exa[a-ln-zA-Z0-9._-]*",
          ".env.exam",
          "**/.env.exam",
          "**/.*/**/.env.exam",
          ".env.exam[a-oq-zA-Z0-9._-]*",
          "**/.env.exam[a-oq-zA-Z0-9._-]*",
          "**/.*/**/.env.exam[a-oq-zA-Z0-9._-]*",
          ".env.examp",
          "**/.env.examp",
          "**/.*/**/.env.examp",
          ".env.examp[a-km-zA-Z0-9._-]*",
          "**/.env.examp[a-km-zA-Z0-9._-]*",
          "**/.*/**/.env.examp[a-km-zA-Z0-9._-]*",
          ".env.exampl",
          "**/.env.exampl",
          "**/.*/**/.env.exampl",
          ".env.exampl[a-df-zA-Z0-9._-]*",
          "**/.env.exampl[a-df-zA-Z0-9._-]*",
          "**/.*/**/.env.exampl[a-df-zA-Z0-9._-]*",
          ".env.example?*",
          "**/.env.example?*",
          "**/.*/**/.env.example?*",
          "id_rsa*",
          "**/id_rsa*",
          "**/.*/**/id_rsa*",
          "id_dsa*",
          "**/id_dsa*",
          "**/.*/**/id_dsa*",
          "id_ecdsa*",
          "**/id_ecdsa*",
          "**/.*/**/id_ecdsa*",
          "id_ed25519*",
          "**/id_ed25519*",
          "**/.*/**/id_ed25519*",
          "*.tfstate.*",
          "**/*.tfstate.*",
          "**/.*/**/*.tfstate.*",
          "*credentials*.json",
          "**/*credentials*.json",
          "**/.*/**/*credentials*.json"
        ]
      }
    },
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          "*.pem",
          "*.key",
          "*.pfx",
          "*.p12",
          "*.jks",
          "*.keystore",
          "*.ppk",
          "*.tfstate",
          "*.har"
        ]
      }
    }
  ]
}
