# Copy to .env and fill in. .env is gitignored; this template is not.
# Nothing in CI reads these -- workflow credentials are GitHub Actions secrets and vars.
#
# Run  python scripts/check_env.py  after filling this in. It tells you which field is
# missing. An empty required field otherwise surfaces as a bare 401, which names nothing.

# EXACTLY ONE backend is authoritative per run: jira, azdo or github. check_env.py checks the
# selected backend's values only (pass --backend <name> to check another).
TICKET_BACKEND=        # REQUIRED -- jira | azdo | github
TICKET_CREATE_CEILING= # REQUIRED -- per-run creation ceiling; no default exists in code
TICKET_STAMP_LABEL=    # optional -- umbrella label/tag, default secure-cicd-kit, no spaces
TICKET_RETRY_CEILING=  # optional -- retries per throttled request (429/503); unset means none
TICKET_INSTANCE_THRESHOLD= # optional -- instances itemised per class; unset means a count only

# ── Jira Cloud ───────────────────────────────────────────────────────────────────────
# REQUIRED. Jira Cloud basic auth is the PAIR email:token. The token alone is a 401, and
# the error does not say the email is what is missing.
JIRA_EMAIL=            # REQUIRED -- the Atlassian ACCOUNT email, not a notification address
JIRA_TOKEN=            # REQUIRED -- id.atlassian.com > Security > Create API token

# REQUIRED. Your site and project. Moving to another tracker changes these values only.
JIRA_HOST=             # REQUIRED -- https://<site>.atlassian.net
JIRA_PROJECT=          # REQUIRED -- the project key
JIRA_STAMP_FIELD=      # REQUIRED -- customfield_<id>, a single-line text field provisioned once
JIRA_EPIC_ID=          # REQUIRED -- numeric id of the product epic, created once by a human
JIRA_CALIBRATION_ISSUE= # REQUIRED -- numeric id of a ticket this credential did NOT create
JIRA_TYPE_CLUSTER=     # optional -- default Story
JIRA_TYPE_INSTANCE=    # optional -- default Subtask
JIRA_TRANSITION_REOPEN= # optional -- transition NAME; absent means the successor path

# ── Azure DevOps ─────────────────────────────────────────────────────────────────────
# The second backend (KDEC-004); the same work-item contract as Jira.
AZDO_PAT=              # REQUIRED -- User settings > Personal access tokens

# REQUIRED. Moving to another organisation changes these values only.
AZDO_ORG_URL=          # REQUIRED -- https://dev.azure.com/<org> (the legacy <org>.visualstudio.com form also works; AZDO_ORG is accepted as the older name)
AZDO_PROJECT=          # REQUIRED -- the project name
AZDO_STAMP_FIELD=      # REQUIRED -- e.g. Custom.KitClusterKey, single-line text, inherited process
AZDO_EPIC_ID=          # REQUIRED -- the tier-1 work item id
AZDO_CALIBRATION_ITEM= # REQUIRED -- a work item this PAT did NOT create
AZDO_TYPE_CLUSTER=     # optional -- default Issue
AZDO_TYPE_INSTANCE=    # optional -- default Task
AZDO_STATE_REOPEN=     # optional -- default To Do
