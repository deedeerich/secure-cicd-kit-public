{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secure-cicd-kit/api/v1/tickets/exemption.schema.json",
  "title": "ticket template: compliance request, exemption (template_version 2)",
  "description": "EXEMPTION (owner, 2026-11-04): the accepted-risk family, \"there to stay\". It maps to accepted risk; it may have a ticket time limit (expires, optional) and has a review cadence (review_every_days, required). Opens an EXEMPTION_REQUEST. KDEC-037.",
  "x-template": "exemption",
  "x-template-version": 2,
  "x-enabled": true,
  "x-ticket-class": "EXEMPTION_REQUEST",
  "x-requested-disposition": "exemption",
  "x-disposition-type": "ACCEPTED_RISK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding",
    "justification",
    "review_every_days",
    "requested_by",
    "evidence"
  ],
  "properties": {
    "finding": {
      "description": "The finding (finding.schema.json).",
      "type": "object"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 @._+\\[\\]-]{1,100}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt": {
          "description": "A custody receipt for the evidence (a store's object id or signature).",
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "review_every_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 730
    },
    "expires": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Optional ticket time limit."
    },
    "register_scope": {
      "type": "string",
      "enum": [
        "repository",
        "central"
      ]
    }
  }
}
