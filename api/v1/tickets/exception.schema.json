{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secure-cicd-kit/api/v1/tickets/exception.schema.json",
  "title": "ticket template: compliance request, exception (template_version 2)",
  "description": "EXCEPTION (owner, 2026-11-04): ALWAYS time-limited (at most 90 days: EXCEPTION_TOO_LONG past it) with a SPECIFIC scope -- e.g. \"this WAF rule blocks us because this traffic triggers it, but it is parameterised and not harmful; from this specific endpoint to this specific endpoint\". A justification and compensating controls are required. Opens an EXCEPTION_REQUEST. KDEC-037.",
  "x-template": "exception",
  "x-template-version": 2,
  "x-enabled": true,
  "x-ticket-class": "EXCEPTION_REQUEST",
  "x-requested-disposition": "exception",
  "x-disposition-type": "ACCEPTED_RISK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding",
    "justification",
    "scope",
    "compensating_controls",
    "expires",
    "requested_by",
    "evidence"
  ],
  "properties": {
    "finding": {
      "description": "The finding (finding.schema.json).",
      "type": "object"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 @._+\\[\\]-]{1,100}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt": {
          "description": "A custody receipt for the evidence (a store's object id or signature).",
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "scope": {
      "description": "A SPECIFIC scope: from what, to what, under what condition.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "condition"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "to": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "condition": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "compensating_controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500
      }
    },
    "expires": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD, after today, at most 90 days away."
    }
  }
}
