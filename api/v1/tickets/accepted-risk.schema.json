{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secure-cicd-kit/api/v1/tickets/accepted-risk.schema.json",
  "title": "ticket template: compliance request, accepted risk (template_version 2)",
  "description": "ACCEPTED_RISK (owner, 2026-11-04): its own type, NOT necessarily an exemption -- legacy hardware awaiting migration or funding; inherent operational risk (\"pilots have to fly in the rain\"). It needs an owner, a rationale, a review date and a risk-register link; no control exemption is requested by it. Opens an ACCEPTED_RISK_REQUEST. KDEC-037.",
  "x-template": "accepted-risk",
  "x-template-version": 2,
  "x-enabled": true,
  "x-ticket-class": "ACCEPTED_RISK_REQUEST",
  "x-requested-disposition": "risk_acceptance",
  "x-disposition-type": "ACCEPTED_RISK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding",
    "justification",
    "owner",
    "review_date",
    "risk_register_ref",
    "requested_by",
    "evidence"
  ],
  "properties": {
    "finding": {
      "description": "The finding (finding.schema.json).",
      "type": "object"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 @._+\\[\\]-]{1,100}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt": {
          "description": "A custody receipt for the evidence (a store's object id or signature).",
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "description": "The rationale."
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 @._+\\[\\]-]{1,100}$"
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "When the acceptance is reviewed, after today."
    },
    "risk_register_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    }
  }
}
